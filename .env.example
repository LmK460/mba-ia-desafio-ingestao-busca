# Chave de API do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Modelo de embeddings do Google (usado para vetorizar os chunks e as perguntas)
GOOGLE_EMBEDDING_MODEL='models/gemini-embedding-001'

# Modelo de LLM do Google (usado para responder as perguntas)
GOOGLE_LLM_MODEL='gemini-3.5-flash-lite'

# Conexão com o PostgreSQL + pgVector (subido pelo docker-compose)
DATABASE_URL='postgresql://postgres:postgres@localhost:5432/rag'

# Nome da coleção de vetores criada no banco
PG_VECTOR_COLLECTION_NAME='pdf_documents'

# Caminho do PDF que será ingerido
PDF_PATH='document.pdf'
